        {
          "id": "2ba907bb-4ec5-4ff2-b6d6-7d5234593023",
          "name": "Let imageserver process multiple objects.",
          "request": {
            "name": "Let imageserver process multiple objects.",
            "description": {
              "content": "If an image server is configured, creates a job in the image server's database to process all the pids from the provided list. Needs admin credentials.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "imageserver",
                "process"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "skipexisting",
                  "value": "<number>",
                  "description": "Value 1 to skip creating a job for this pid if a job for a pid already exists."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "pids",
                  "value": "{\"pids\":[\"<string>\",\"<string>\"]}",
                  "type": "text",
                  "description": ""

          "request": {
            "name": "Post to (re-)process one pid on imageserver.",
            "description": {
              "content": "Post an object to be processed to the imageserver. Needs admin credentials",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "imageserver",
                ":pid",

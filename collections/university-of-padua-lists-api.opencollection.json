{
  "opencollection": "1.0.0",
  "info": {
    "name": "PHAIDRA datastream lists API",
    "version": "3.0"
  },
  "items": [
    {
      "info": {
        "name": "lists",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Add list",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://phaidra.unipd.it/api/list/add",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "name",
                  "type": "text",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Add a list to the user (from credentials)."
        },
        {
          "info": {
            "name": "Get object list exposed under specified token.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://phaidra.unipd.it/api/list/token/:token",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "path",
                "description": "the requested token no"
              }
            ]
          },
          "docs": "Get object list exposed under specified token."
        },
        {
          "info": {
            "name": "Get list detail",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://phaidra.unipd.it/api/list/:lid",
            "params": [
              {
                "name": "lid",
                "value": "",
                "type": "path",
                "description": "lid - list id"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Get list detail"
        },
        {
          "info": {
            "name": "Add objects to list",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://phaidra.unipd.it/api/list/:lid/members/add",
            "params": [
              {
                "name": "lid",
                "value": "",
                "type": "path",
                "description": "lid - list id"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "members",
                  "type": "text",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Add objects to list"
        },
        {
          "info": {
            "name": "Remove objects from list",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://phaidra.unipd.it/api/list/:lid/members/remove",
            "params": [
              {
                "name": "lid",
                "value": "",
                "type": "path",
                "description": "lid - list id"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "members",
                  "type": "text",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Remove objects from list"
        },
        {
          "info": {
            "name": "Remove list",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://phaidra.unipd.it/api/list/:lid/remove",
            "params": [
              {
                "name": "lid",
                "value": "",
                "type": "path",
                "description": "lid - list id"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Remove list (input list id)."
        },
        {
          "info": {
            "name": "Create a list token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://phaidra.unipd.it/api/list/:lid/token/create",
            "params": [
              {
                "name": "lid",
                "value": "",
                "type": "path",
                "description": "lid - list id"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "The token can be used in the /list/token/{token} request to create a URL under which the list can be publicly displayed."
        },
        {
          "info": {
            "name": "Delete list token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://phaidra.unipd.it/api/list/:lid/token/delete",
            "params": [
              {
                "name": "lid",
                "value": "",
                "type": "path",
                "description": "lid - list id"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Delete list token"
        },
        {
          "info": {
            "name": "Get user's object lists",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://phaidra.unipd.it/api/lists",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Get user's object lists"
        }
      ]
    }
  ],
  "bundled": true
}
        {
          "id": "aeafe8f9-79e5-497b-82b1-a853d320eeb4",
          "name": "Add blacklist entries from TSV or JSON payload",
          "request": {
            "name": "Add blacklist entries from TSV or JSON payload",
            "description": {
              "content": "Ingest TSV with columns `AC-Nummer` and `Identifier Phaidra`, and create records in `oai_records_blacklist` if ac_number/pid not already present. The blacklist is a list of PIDs which should not be included in a particular set in OAI-PMH, e.g. because the harvester gets those objects by other means (avoids duplicity).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oai",
                "blacklist"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "sets",
                  "value": "<string>",
                  "description": "Optional sets (comma-separated), if not supplied in JSON body."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sets\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"tsv\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "2dffd010-da25-4e07-8fe1-ce15853cf726",
              "name": "Summary of inserted/existing/invalid rows",
              "originalRequest": {
                "url": {
                  "path": [
                    "oai",
                    "blacklist"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "sets",
                      "value": "<string>"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"sets\": [\n    \"phaidra4primo\"\n  ],\n  \"tsv\": \"AC-Nummer\\tIdentifier Phaidra\\nAC00001880\\to:2045295\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,

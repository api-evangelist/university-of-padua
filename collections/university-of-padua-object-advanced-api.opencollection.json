      "items": [
        {
          "info": {
            "name": "Checks rights",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://phaidra.unipd.it/api/authz/check/:pid/:op",
            "params": [
              {
                "name": "pid",
                "value": "",
                "type": "path",
                "description": "pid - object id"
              },
              {
                "name": "op",
                "value": "",
                "type": "path",
                "description": "rights for operation"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Checks if the authenticated user has appropriate rights for an operation on the object (readable/writable). Can also be checked for unauthenticated user."
        },
        {
          "info": {
            "name": "Re-index multiple objects at once",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://phaidra.unipd.it/api/index ",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Post a list of objects which should be re-indexed - needs admin credentials"
        },
